{
  "schema_version": "cnn_msp_experiment_v1",
  "status": "draft_for_review",
  "name": "cnn_msp_baseline_v1",
  "architecture": {
    "channels": [32, 64, 128],
    "kernel_sizes": [7, 5, 3],
    "feature_dim": 128,
    "dropout": 0.2
  },
  "training": {
    "optimizer": "Adam",
    "learning_rate": 0.001,
    "weight_decay": 0.0,
    "batch_size": 64,
    "max_epochs": 50,
