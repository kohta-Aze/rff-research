    "selection": "minimum_validation_known_cross_entropy",
    "augmentation": "none"
  },
  "threshold": {
    "rule": "maximize_mean_known_correct_accept_and_unknown_reject",
    "tie_break": "highest_threshold",
    "acceptance": "msp_greater_than_or_equal_to_threshold",
    "temperature": 1.0
  },
  "planned_comparison": {
    "folds": [0, 1, 2, 3, 4],
    "seeds": [42, 43, 44],
    "primary_metric": "oscr_auc",
    "aggregation": "per_date_mean_and_std_across_runs_not_pooled_predictions"
  }
